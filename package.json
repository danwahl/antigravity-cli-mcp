{
  "name": "@danwahl/antigravity-cli-mcp",
  "type": "module",
  "version": "0.3.2",
  "description": "MCP server that exposes Antigravity CLI (agy) as a single tool for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danwahl/antigravity-cli-mcp.git"
  },
  "keywords": [
    "mcp",
    "antigravity",
    "agy",
    "gemini",
    "claude",
    "llm",
    "ai"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "antigravity-cli-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && shx chmod +x dist/*.js",
    "test": "node --import tsx/esm --test src/lib.test.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "!dist/*.test.js"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "shx": "^0.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
